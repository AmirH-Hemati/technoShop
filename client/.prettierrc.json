{
  "plugins": [
    "prettier-plugin-tailwindcss",
    "@trivago/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "^(vite|@vitejs)(/(.*))?$",
    "^(react|react-dom)(/(.*))?$",
    "^react-router(/(.*))?$",
    "^react-froala(/(.*))?$",
    "^react-leaflet(/(.*))?$",
    "^react-toastify(/(.*))?$",
    "^react-confetti(/(.*))?$",
    "^(react-hook-form|@hookform/resolvers|zod)(/(.*))?$",
    "^@tanstack(/(.*))?$",
    "^leaflet(/(.*))?$",
    "^zustand(/(.*))?$",
    "^clsx(/(.*))?$",
    "^axios(/(.*))?$",
    "^iconsax-reactjs(/(.*))?$",
    "^lucide-react(/(.*))?$",
    "^motion(/(.*))?$",
    "^nuqs(/(.*))?$",
    "^swiper(/(.*))?$",
    "<THIRD_PARTY_MODULES>",
    "^@/components",
    "^@/ui",
    "^@/context",
    "^@/features",
    "^@/data",
    "^@/dto",
    "^@/services",
    "^@/hooks",
    "^@/icons",
    "^@/layouts",
    "^@/modals",
    "^@/pages",
    "^@/providers",
    "^@/schemas",
    "^@/stores",
    "^@/types",
    "^@/utils",
    "^@/styles",
    "^(\\.|\\.\\.)/(.(?!.css))*$",
    "\\.css$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderGroupNamespaceSpecifiers": true
}
